{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "QuotesApi"
    }
  },

  "Entra": {
    "TenantId": "7e394fc8-4b86-4cfe-810e-43f86f8bec47",
    "Audience": "api://7d89a910-1bff-48b7-a155-1b3d12d38058"
  },

  "OpenTelemetry": {
    "ServiceName": "QuotesApi"
  },

  "KeyVault": {
    "Uri": ""
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiUsers",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },

  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=QuotesDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;"
  }
